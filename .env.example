# Server
SERVER_PORT=8080

# Infrastructure
MONGODB_URI=mongodb://mongodb:27017/timetable_bot
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Admin auth
ADMIN_AUTH_USERNAME=admin
ADMIN_AUTH_PASSWORD=admin123
ADMIN_AUTH_TOKEN=

# Telegram bot
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=
TELEGRAM_BOT_WEBHOOK_URL=
TELEGRAM_BOT_REGISTER_WEBHOOK_ON_STARTUP=true

# Notifications
notifications.queue=notifications.queue
notifications.task-reminder-lead-minutes=30
notifications.scheduler-fixed-delay-ms=60000
notifications.dlq.exchange=notifications.dlx
notifications.dlq.queue=notifications.queue.dlq
notifications.dlq.routing-key=notifications.dead

# LLM API (Anthropic / OpenAI / GigaChat)
LLM_API_ENABLED=true
LLM_API_KEY=

# Healthcheck authors (comma-separated student names)
HEALTHCHECK_AUTHORS=Student1,Student2
